diff --git a/lib/validate-depth.js b/lib/validate-depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..18a9d2d03cfa1267234dda900081eb07cf733d20
--- /dev/null
+++ b/lib/validate-depth.js
@@ -0,0 +1,15 @@
+'use strict';
+
+// Bound every public AST walker, including caller-supplied ASTs and cyclic nodes.
+module.exports = ast => {
+  const stack = [[ast, 0]];
+  while (stack.length) {
+    const [node, depth] = stack.pop();
+    if (depth > 128) {
+      throw new RangeError('braces maximum nesting depth exceeded');
+    }
+    if (node && Array.isArray(node.nodes)) {
+      for (const child of node.nodes) stack.push([child, depth + 1]);
+    }
+  }
+};
