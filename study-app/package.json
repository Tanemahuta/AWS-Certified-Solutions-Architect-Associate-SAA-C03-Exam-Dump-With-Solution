{
  "name": "saa-question-cli",
  "version": "1.0.0",
  "private": true,
  "description": "CLI for building and querying the SAA-C03 question database",
  "type": "module",
  "scripts": {
    "cli": "node --no-warnings --loader ts-node/esm src/cli.ts",
    "create-db": "npm run cli -- create-db",
    "build": "npm run create-db && node scripts/generate-webapp-database.mjs && vite build --config webapp/vite.config.ts",
    "dev": "node scripts/generate-webapp-database.mjs && vite --config webapp/vite.config.ts",
    "preview": "vite preview --config webapp/vite.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json && tsc -p webapp/tsconfig.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:deployment": "node --test scripts/build-version.test.mjs scripts/deployment-overlay.test.mjs ../.github/actions/publish-study-app/prepare-site.test.mjs",
    "test:security": "node --test scripts/dependency-security.test.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "release": "semantic-release",
    "licenses": "node scripts/check-licenses.mjs",
    "audit": "pnpm audit --audit-level=moderate"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "levenshtein": "^1.0.5",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/levenshtein": "^1.0.4",
    "@types/node": "^24.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.1",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.2",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  }
}
